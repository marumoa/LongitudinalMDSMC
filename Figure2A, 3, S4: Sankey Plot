df_all <- df_raw %>%
  filter(MRN != "", Diagnosis != "", FU1 != "")

df_fu2 <- df_all %>%
  filter(FU2 != "")

# ======================
# Colors
# ======================
cluster_colors <- c(
  "1"  = "#7b3294",
  "2"  = "#2c7fb8",
  "3"  = "#1a9850",
  "4"  = "#fdbf11",
  "5"  = "#e31a1c",
